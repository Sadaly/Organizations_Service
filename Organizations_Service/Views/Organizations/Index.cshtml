@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IReadOnlyList<OrganizationDto>
@{
    ViewData["Title"] = "Organizations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Organizations</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add</a>
</div>

<form asp-action="Index" method="get" class="d-flex gap-2 mb-3">
    <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name or TIN" />
    <button type="submit" class="btn btn-outline-secondary">Search</button>
    <a asp-action="Index" class="btn btn-outline-light text-dark border">Reset</a>
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">No organizations found.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>TIN</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Description</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var org in Model)
            {
                <tr>
                    <td>@org.Name</td>
                    <td>@org.Tin</td>
                    <td>@org.Phone</td>
                    <td>@org.Email</td>
                    <td>@org.Description</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@org.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-action="Edit" asp-route-id="@org.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@org.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
